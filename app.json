{
  "expo": {
    "name": "eventify-mobile",
    "slug": "eventify-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "eventify",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eventify.mobile"
    },
    "android": {
      "package": "com.eventify.mobile",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Eventify usa tu ubicacion para mostrar experiencias cercanas en el mapa."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Eventify usa la camara para escanear QR de entradas en puerta.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
