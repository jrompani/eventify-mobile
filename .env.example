# Web o app corriendo en la misma PC:
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Android Emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8080/api/v1

# Expo Go en celular fisico conectado a la misma red Wi-Fi:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.100.8:8080/api/v1

# Google Sign-In nativo.
# Este valor es publico en la app y NO es un secret.
# Usar el OAuth Client ID tipo Web para que Android/iOS devuelvan idToken.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_FACEBOOK_CLIENT_ID=

# Key Android Maps. Esta key queda embebida en la app.
# Restringir en Google Cloud por package com.eventify.mobile + SHA-1/SHA-256 y solo Maps SDK for Android.
# Variable de build nativo, no EXPO_PUBLIC:
# GOOGLE_MAPS_API_KEY=

# Release Android signing. Never commit the real keystore or passwords.
# EVENTIFY_RELEASE_STORE_FILE=../keystores/eventify-release.jks
# EVENTIFY_RELEASE_STORE_PASSWORD=
# EVENTIFY_RELEASE_KEY_ALIAS=eventify
# EVENTIFY_RELEASE_KEY_PASSWORD=
